{
  "name": "anops-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "marketing:seed-demo": "vite-node -c vitest.config.mts scripts/seed-marketing-demo.ts",
    "marketing:worker": "node scripts/marketing-worker.mjs --once",
    "marketing:worker:watch": "node scripts/marketing-worker.mjs",
    "telegram:poll": "vite-node -c vitest.config.mts scripts/telegram-poll.ts --",
    "hr:seed-demo": "node scripts/seed-hr-demo.mjs",
    "hr:clean-demo": "node scripts/seed-hr-demo.mjs --clean",
    "hr:ai-eval": "vitest run --config eval/vitest.eval.config.mts --disable-console-intercept",
    "db:migrate-tenancy": "node scripts/migrate-multi-tenant.mjs",
    "finance:ocr-check": "vite-node -c vitest.config.mts scripts/finance-ocr-live-check.ts --",
    "finance:seed-demo": "vite-node -c vitest.config.mts scripts/seed-finance-demo.ts --",
    "platform:maintenance": "node scripts/platform-maintenance.mjs --once",
    "platform:maintenance:watch": "node scripts/platform-maintenance.mjs"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.9.2",
    "bcryptjs": "^3.0.3",
    "cloudflare": "^7.3.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.61.0",
    "mongodb": "^6.21.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "nodemailer": "^10.2.1"
  }
}
