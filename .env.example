MONGODB_URI=mongodb://localhost:27017
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------
# Public base URL used in emailed links (verification, password
# reset, unsubscribe). In production this must be the public HTTPS
# address, never localhost, or recipients cannot open the links.
# Falls back to NEXTAUTH_URL when unset. Email campaigns are
# refused in production when the resolved URL is local/private.
# ---------------------------------------------------------------
# APP_URL=https://an-ops.netlify.app   (set this in the deployment so emailed links use the public address)

# ---------------------------------------------------------------
# Email / SMTP (verification, password reset, and marketing email)
# Leave these commented out in development: emails and links are
# printed to the server console. Uncomment and fill in to send real
# email. Only set these to real values — do not leave them blank.
# One account is used for both authentication mail and campaigns;
# marketing adds its own consent, suppression and rate rules.
# ---------------------------------------------------------------
# Gmail: smtp.gmail.com, port 587, secure=false, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# Use "true" for implicit TLS (port 465), "false" for STARTTLS (port 587).
# EMAIL_SERVER_SECURE=false
# EMAIL_SERVER_USER=your-address@gmail.com
# EMAIL_SERVER_PASSWORD=your-16-character-app-password
# Must be a valid sender on your provider's domain. For Gmail it must
# normally be the same address as EMAIL_SERVER_USER.
# EMAIL_FROM="AnOps <no-reply@anops.app>"
# Logo used in verification and password reset emails
# EMAIL_LOGO_URL=https://i.ibb.co/dwVPDPVh/anops-horizontal-logo.png : dark
# EMAIL_LOGO_URL=https://i.ibb.co/4ZtzmXKH/anops-logo-horizontal-white.png : white

# AI Providers — Key names (comma-separated lists)
# Each provider will automatically rotate through keys on rate-limit (429)

# Groq — get free keys at https://console.groq.com
# Rotates automatically across all listed keys on 429
GROQ_API_KEYS=

# OpenRouter — get a free key at https://openrouter.ai
# Uses free models only (identified by ":free" suffix)
OPENROUTER_API_KEY=

# Google Gemini — get a free key at https://aistudio.google.com
# Rotates across multiple keys if provided
# Gemini (AI Logo Studio, receipt reading, AI features). Comma-separated list, one key per entry, no spaces needed:
#   GEMINI_API_KEYS=key1,key2,key3
# A missing comma joins two keys into one invalid entry that is ignored (the studio warns administrators).
# Image generation needs a Google project with billing enabled: the free tier has no image quota.
GEMINI_API_KEYS=
# Optional. Default: gemini-nano-banana-2.1 (Google's recommended image model). Others: gemini-3.1-flash-lite-image (cheapest),
# gemini-3.1-flash-image, gemini-3-pro-image (best text rendering), gemini-2.5-flash-image (legacy).
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional. Only https:// (or http://localhost) is accepted. Use for a staging proxy or a local test double.
# GEMINI_API_BASE_URL=

# Optional: provider order per AI task (comma-separated: groq, openrouter, gemini)
# AI_ROUTE_COPILOT_CHAT=groq,openrouter,gemini
# AI_ROUTE_ADVISOR_JSON=gemini,groq,openrouter
# AI_ROUTE_POLICY_QA=gemini,groq,openrouter
# Optional: skip providers in task routing, to rehearse an outage
# AI_DISABLED_PROVIDERS=groq

# AI Command Center platform controls (see docs/AI_COMMAND_CENTER_DEPLOYMENT.md). All optional.
# Set to true to block ALL AI for every company immediately (chat, commands, drafts, confirmations, legacy AI features).
AI_KILL_SWITCH=
# Estimate price per 1,000 measured tokens. Cost appears in the AI usage view only when this is set, and is always an estimate.
AI_PRICE_PER_1K_TOKENS=
AI_PRICE_CURRENCY=
# Optional company-wide daily spending cap in AI_PRICE_CURRENCY (needs AI_PRICE_PER_1K_TOKENS). Enforced as the equivalent tokens.
AI_COMPANY_DAILY_COST_LIMIT=


# ---------------------------------------------------------------
# Marketing (see docs/MARKETING.md). All optional: a missing value
# disables only its integration. Never commit real values.
# ---------------------------------------------------------------
# Facebook Pages (Meta app). Redirect URI: <NEXTAUTH_URL>/api/v1/marketing/social/callback
# FACEBOOK_APP_ID=your-meta-app-id
# FACEBOOK_APP_SECRET=your-meta-app-secret
# 32 random bytes: base64 (44 chars, ends with '=') or hex (64 chars). Generate: openssl rand -base64 32
# SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
# Delivery webhook signing secret (at least 32 characters)
# MARKETING_WEBHOOK_SECRET=replace-with-a-long-random-string
# Bearer secret for the background worker endpoint (at least 32 characters)
# MARKETING_WORKER_SECRET=replace-with-a-long-random-string
# Optional. Comma-separated controlled recipients. Applies to SMTP and Brevo email and to SMS.
# When set, every other destination is refused before any provider call.
# MARKETING_SEND_ALLOWLIST=you@example.com,+21620123456

# ---------------------------------------------------------------
# Brevo — marketing SMS delivery and optional email fallback.
# Brevo API only. SMTP above is preferred for email when configured.
# Leave empty to keep delivery unconfigured; campaigns then cannot be scheduled.
# ---------------------------------------------------------------
# API key from Brevo: SMTP & API settings (the name is case-sensitive)
BREVO_API_key=
# Sender for campaign email. The domain must be verified in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# SMS sender: up to 11 letters and digits, or up to 15 digits. Registration may be required per country.
BREVO_SMS_SENDER=
# Long random path token for Brevo event callbacks (at least 32 characters). Brevo does not sign webhooks.
BREVO_WEBHOOK_TOKEN=
# Set to true only after confirming Brevo's policy for marketing mail through the transactional email API.
BREVO_EMAIL_MARKETING_APPROVED=false

# Telegram bot (Marketing -> Telegram channel). One central bot shared by all companies.
# Create it with @BotFather; the token looks like 123456789:AA... Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# The username BotFather gave the bot (with or without the leading @). Used to build t.me deep links.
TELEGRAM_BOT_USERNAME=
# Random 32-256 characters (letters, digits, _ or -). Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
